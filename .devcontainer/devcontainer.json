{
  "name": "COVID-19 Mortality Prediction Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/app.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "streamlit run src/app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Mortality Prediction Lab",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
